{
  "name": "backend_smart_irrigation",
  "version": "1.0.0",
  "main": "server.js",
  "license": "MIT",
  "scripts": {
    "start": "node server.js",
     "dev": "nodemon server.js",
     "test": "jest --config jest.config.js --passWithNoTests",
     "test:unit": "jest --runTestsByPath tests/unit --passWithNoTests",
     "test:integration": "jest --runTestsByPath tests/integration --passWithNoTests",
     "test:e2e": "jest --runTestsByPath tests/e2e --passWithNoTests",
     "test:coverage": "jest --coverage",
     "test:all": "npm run test && npm run test:unit && npm run test:integration && npm run test:e2e && npm run test:coverage",
     "lint": "eslint . --ext .js,.ts,.tsx --fix",
     "format": "prettier --write .",
     "mutate": "stryker run",
     "sonar": "sonar-scanner",
     "prepare": "husky install"
  },
  "devDependencies": {
    "@babel/core": "^8.0.5",
    "@babel/preset-env": "^8.0.5",
    "@babel/preset-typescript": "^8.0.1",
    "@pact-foundation/pact": "^17.1.4",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/jest-runner": "^10.0.0",
    "@stryker-mutator/typescript-checker": "^10.0.0",
    "@types/jest": "^30.0.0",
    "@types/supertest": "^7.2.1",
    "babel-jest": "^30.5.1",
    "jest": "^30.5.1",
    "pact": "^4.3.1",
    "playwright": "^1.63.0",
    "snyk": "^1.1307.2",
    "supertest": "^7.2.2"
  }
}
